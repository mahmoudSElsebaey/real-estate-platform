# ===========================================
# Aether Residences - Environment Variables
# ===========================================
# Copy this file to .env.local and fill values.
# NEVER commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aether Residences

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/aether-residences
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/aether-residences

# Authentication
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Image / Media (Cloudinary or equivalent)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments (abstraction layer - Stage 8)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
