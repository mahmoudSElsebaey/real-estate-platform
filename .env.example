# ===========================================
# Aqarco - Environment Variables
# ===========================================
# Copy this file to .env.local and fill values.
# NEVER commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aqarco

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/aqarco
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/aqarco

# Authentication (REQUIRED in production — min 32 characters)
# Generate: openssl rand -base64 48
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Image / Media
# When set, uploads go to Cloudinary (recommended for production).
# When empty, files are stored under public/uploads/ (local/dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (abstraction layer)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
